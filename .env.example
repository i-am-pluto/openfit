# OAuth client from Google Cloud console, Web application type.
# Authorized redirect URI must include <origin>/auth/callback for every origin
# you use: 127.0.0.1:7788 (npm run serve), :7789 (npm run dev), :7790 (desktop app).
#
# The desktop app reads this file from the repository when run from a checkout.
# A packaged build reads it from its user data directory instead; see
# docs/SELF_HOSTING.md#where-a-packaged-app-reads-env.
OPENFIT_GOOGLE_CLIENT_ID=
OPENFIT_GOOGLE_CLIENT_SECRET=

# Bare https origin, no path. Required to sign in from another device.
# The server only. The desktop app is plain-http loopback and ignores this.
# OPENFIT_PUBLIC_ORIGIN=https://your-host.tail-abc123.ts.net

# Absolute host paths for the Docker bind mounts. Absolute and explicit because
# `sudo docker compose` resolves ${HOME} to /root, which would mount an empty
# directory over your data instead of failing.
OPENFIT_HOST_DATA_DIR=/home/you/.local/share/openfit
OPENFIT_HOST_CLAUDE_DIR=/home/you/.claude
